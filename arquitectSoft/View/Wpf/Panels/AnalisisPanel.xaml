<UserControl x:Class="arquitectSoft.View.Wpf.Panels.AnalisisPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             FontFamily="Segoe UI"
             AllowDrop="True"
             DragOver="Ventana_DragOver"
             DragLeave="Ventana_DragLeave"
             Drop="Ventana_Drop">

    <UserControl.Resources>

        <!-- Fuente incrustada Plus Jakarta Sans (4 pesos: 400/500/600/700) -->
        <FontFamily x:Key="Jakarta">pack://application:,,,/Resources/Fonts/#Plus Jakarta Sans</FontFamily>

        <!-- ===== Paleta gris NEUTRO (sin azul) + acento naranja ===== -->
        <SolidColorBrush x:Key="Base"        Color="#0B0B0B"/>
        <SolidColorBrush x:Key="Panel"       Color="#1E1E1E"/>
        <SolidColorBrush x:Key="PanelBorder" Color="#2F2F2F"/>
        <SolidColorBrush x:Key="InputDark"   Color="#0E0E0E"/>
        <SolidColorBrush x:Key="Header"       Color="#262626"/>
        <SolidColorBrush x:Key="Hover"        Color="#2A2A2A"/>
        <SolidColorBrush x:Key="Accent"       Color="#E07B5B"/>
        <SolidColorBrush x:Key="AccentDark"   Color="#C96A4C"/>
        <SolidColorBrush x:Key="TextPrimary"  Color="#ECECEC"/>
        <SolidColorBrush x:Key="TextMuted"    Color="#8C8C8C"/>
        <SolidColorBrush x:Key="TopLight"     Color="#16FFFFFF"/>

        <!-- ===== Icono-acción SIN botón: solo icono + texto; icono naranja al hover ===== -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <StackPanel x:Name="sp" Background="Transparent"
                                    HorizontalAlignment="Center" Width="74">
                            <TextBlock x:Name="ico" Text="{TemplateBinding Tag}"
                                       FontFamily="Segoe MDL2 Assets" FontSize="24"
                                       Foreground="{StaticResource TextPrimary}"
                                       HorizontalAlignment="Center"
                                       RenderTransformOrigin="0.5,0.5">
                                <TextBlock.RenderTransform>
                                    <ScaleTransform x:Name="icoScale" ScaleX="1" ScaleY="1"/>
                                </TextBlock.RenderTransform>
                            </TextBlock>
                            <TextBlock Text="{TemplateBinding Content}"
                                       Foreground="{StaticResource TextMuted}" FontSize="12" FontWeight="Medium"
                                       HorizontalAlignment="Center" Margin="0,6,0,0"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ico" Property="Foreground" Value="{StaticResource Accent}"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="icoScale"
                                                Storyboard.TargetProperty="ScaleX" To="1.14" Duration="0:0:0.12"/>
                                            <DoubleAnimation Storyboard.TargetName="icoScale"
                                                Storyboard.TargetProperty="ScaleY" To="1.14" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="icoScale"
                                                Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.12"/>
                                            <DoubleAnimation Storyboard.TargetName="icoScale"
                                                Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ico" Property="Foreground" Value="#C96A4C"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Botón redondo (cerrar previsualizador), hover naranja ===== -->
        <Style x:Key="DotButton" TargetType="Button">
            <Setter Property="Width" Value="14"/>
            <Setter Property="Height" Value="14"/>
            <Setter Property="Margin" Value="5,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#0B0B0B"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="dot" Fill="#3A3A3A"/>
                            <ContentPresenter x:Name="g" Opacity="0"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="dot" Property="Fill" Value="#E07B5B"/>
                                <Setter TargetName="g" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="dot" Property="Fill" Value="#C96A4C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Caja de texto numérica (fondo oscuro, foco naranja) ===== -->
        <Style x:Key="DarkBox" TargetType="Border">
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Background" Value="{StaticResource InputDark}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="38"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SpinButton" TargetType="RepeatButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontSize" Value="7"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border x:Name="bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NumTextBox" TargetType="TextBox">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="CaretBrush" Value="{StaticResource Accent}"/>
            <Setter Property="SelectionBrush" Value="{StaticResource Accent}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="11,0,0,0"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Margin" Value="3,0,0,5"/>
        </Style>

        <!-- ===== Pestañas ===== -->
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="9"
                                Margin="3,0" Padding="16,9,16,11">
                            <Grid>
                                <ContentPresenter ContentSource="Header"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Border x:Name="underline" Height="3" CornerRadius="2"
                                        VerticalAlignment="Bottom" Margin="8,0,8,-7"
                                        Background="{StaticResource Accent}"
                                        RenderTransformOrigin="0,0.5">
                                    <Border.RenderTransform>
                                        <ScaleTransform x:Name="ulScale" ScaleX="0" ScaleY="1"/>
                                    </Border.RenderTransform>
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsSelected" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                <MultiTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ulScale"
                                                Storyboard.TargetProperty="ScaleX"
                                                To="1" Duration="0:0:0.25">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </MultiTrigger.EnterActions>
                                <MultiTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ulScale"
                                                Storyboard.TargetProperty="ScaleX"
                                                To="0" Duration="0:0:0.18"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </MultiTrigger.ExitActions>
                            </MultiTrigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Accent}"/>
                                <Setter Property="Foreground" Value="#201712"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter TargetName="underline" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="bd" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#E07B5B" BlurRadius="12"
                                                          ShadowDepth="0" Opacity="0.45"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Scrollbar moderna ===== -->
        <Style x:Key="ScrollThumb" TargetType="Thumb">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="t" CornerRadius="5" Background="#3C3C3C" Margin="2">
                            <Border.Effect>
                                <DropShadowEffect Color="Black" BlurRadius="5" ShadowDepth="0" Opacity="0.6"/>
                            </Border.Effect>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="t" Property="Background" Value="#565656"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="t" Property="Background" Value="{StaticResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ScrollPage" TargetType="RepeatButton">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="#14000000">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageUpCommand"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollThumb}" MinHeight="30"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageDownCommand"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="Height" Value="12"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Grid Background="#14000000">
                                    <Track x:Name="PART_Track">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageLeftCommand"/>
                                        </Track.DecreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource ScrollThumb}" MinWidth="30"/>
                                        </Track.Thumb>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageRightCommand"/>
                                        </Track.IncreaseRepeatButton>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ===== DataGrid oscuro (gris neutro) ===== -->
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="True"/>
            <Setter Property="CanUserResizeColumns" Value="True"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#262626"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="RowBackground" Value="Transparent"/>
            <Setter Property="AlternatingRowBackground" Value="#232323"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="ColumnHeaderHeight" Value="38"/>
            <Setter Property="EnableRowVirtualization" Value="True"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource Header}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
            <Setter Property="BorderBrush" Value="#363636"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4,6"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGridRow">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#241B12"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#33E07B5B"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ===== Menú contextual oscuro ===== -->
        <Style TargetType="ContextMenu">
            <Setter Property="Background" Value="#1B1B1B"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="5">
                            <Border.Effect>
                                <DropShadowEffect Color="Black" BlurRadius="16" ShadowDepth="3" Opacity="0.6"/>
                            </Border.Effect>
                            <StackPanel IsItemsHost="True"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#33E07B5B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tarjeta que envuelve cada DataGrid -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Background" Value="{StaticResource Panel}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="Black" BlurRadius="18" ShadowDepth="5"
                                      Direction="270" Opacity="0.5"/>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- ================== LAYOUT (el chrome y el liquid glass los aporta MdiChild) ================== -->
    <Grid>
        <!-- ===== Contenido ===== -->
        <Grid Margin="16,10,16,14" TextElement.FontFamily="{StaticResource Jakarta}"
              TextElement.Foreground="{StaticResource TextPrimary}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- barra-panel superior -->
                <RowDefinition Height="Auto"/>  <!-- estado -->
                <RowDefinition Height="*"/>     <!-- pestañas + tarjeta -->
            </Grid.RowDefinitions>

            <!-- ===== Barra-panel superior ===== -->
            <Border Grid.Row="0" Background="{StaticResource Panel}"
                    BorderBrush="{StaticResource PanelBorder}" BorderThickness="1"
                    CornerRadius="16" Padding="20,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Iconos-acción (sin botón) -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BtnCargar" Style="{StaticResource IconButton}"
                                Tag="&#xE8E5;" Content="Cargar" Click="Cargar_Click"
                                ToolTip="Cargar archivos TXT"/>
                        <Button x:Name="BtnCancelar" Style="{StaticResource IconButton}"
                                Tag="&#xE711;" Content="Cancelar" Click="Cancelar_Click"
                                ToolTip="Limpiar resultados"/>
                        <Button x:Name="BtnExportar" Style="{StaticResource IconButton}"
                                Tag="&#xE74E;" Content="Exportar" Click="Exportar_Click"
                                ToolTip="Exportar a Excel"/>
                        <Button x:Name="BtnPreview" Style="{StaticResource IconButton}"
                                Tag="&#xE8A1;" Content="Datos" Click="Preview_Click"
                                ToolTip="Mostrar/ocultar datos cargados (sin procesar)"/>
                        <Button x:Name="BtnChange" Style="{StaticResource IconButton}"
                                Tag="&#xE70F;" Content="Acabado" Click="CambiarAcabado_Click"
                                ToolTip="Cambiar acabado" Visibility="Collapsed"/>
                    </StackPanel>

                    <!-- Cajas de texto oscuras (Medida Base / % Desperdicio) -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel Margin="10,0">
                            <TextBlock Text="MEDIDA BASE" Style="{StaticResource FieldLabel}"/>
                            <Border Style="{StaticResource DarkBox}" Width="108">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Width="22">
                                        <RepeatButton Style="{StaticResource SpinButton}" Height="19"
                                                      Content="&#xE70E;" Click="MedidaUp_Click"/>
                                        <RepeatButton Style="{StaticResource SpinButton}" Height="19"
                                                      Content="&#xE70D;" Click="MedidaDown_Click"/>
                                    </StackPanel>
                                    <TextBox x:Name="TxtMedidaBase" Text="2960"
                                             Style="{StaticResource NumTextBox}" PreviewTextInput="SoloEnteros"/>
                                </DockPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Margin="10,0">
                            <TextBlock Text="% DESPERDICIO" Style="{StaticResource FieldLabel}"/>
                            <Border Style="{StaticResource DarkBox}" Width="90">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Width="22">
                                        <RepeatButton Style="{StaticResource SpinButton}" Height="19"
                                                      Content="&#xE70E;" Click="DesperdicioUp_Click"/>
                                        <RepeatButton Style="{StaticResource SpinButton}" Height="19"
                                                      Content="&#xE70D;" Click="DesperdicioDown_Click"/>
                                    </StackPanel>
                                    <TextBox x:Name="TxtDesperdicio" Text="0"
                                             Style="{StaticResource NumTextBox}" PreviewTextInput="SoloEnteros"/>
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===== Estado ===== -->
            <Grid Grid.Row="1" Margin="6,12,6,4">
                <TextBlock x:Name="LblEstado" Text="Listo. Carga uno o varios archivos TXT para analizar."
                           Foreground="{StaticResource TextMuted}" FontSize="12" VerticalAlignment="Center"/>
                <TextBlock x:Name="LblRuta" Text="" HorizontalAlignment="Right"
                           Foreground="#6A6A6A" FontSize="11" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" MaxWidth="540"/>
            </Grid>

            <!-- ===== Pestañas con tarjeta + previsualizador redimensionable ===== -->
            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="130"/>
                    <RowDefinition x:Name="FilaSplitter" Height="0"/>
                    <RowDefinition x:Name="FilaPreview" Height="0" MinHeight="0"/>
                </Grid.RowDefinitions>

                <TabControl x:Name="Tabs" Grid.Row="0" Background="Transparent" BorderThickness="0"
                            Padding="0,6,0,0" SelectionChanged="Tabs_SelectionChanged">
                    <TabItem Header="Perfilería">
                        <Border Style="{StaticResource Card}">
                            <DataGrid x:Name="DgPerfilMetalico">
                                <DataGrid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Remplazar SubComponente" Click="RemplazarSub_Click"/>
                                        <MenuItem Header="Cambiar Acabado Temporal" Click="AcabadoTemporal_Click"/>
                                    </ContextMenu>
                                </DataGrid.ContextMenu>
                            </DataGrid>
                        </Border>
                    </TabItem>
                    <TabItem Header="Herrajes">
                        <Border Style="{StaticResource Card}"><DataGrid x:Name="DgPerfilMetalicoHerraje"/></Border>
                    </TabItem>
                    <TabItem Header="Vidrio y Paneles">
                        <Border Style="{StaticResource Card}"><DataGrid x:Name="DgVidrioPaneles"/></Border>
                    </TabItem>
                    <TabItem Header="Puertas">
                        <Border Style="{StaticResource Card}"><DataGrid x:Name="DgPuertas" LoadingRow="DgPuertas_LoadingRow"/></Border>
                    </TabItem>
                    <TabItem Header="Puertas Herrajes">
                        <Border Style="{StaticResource Card}"><DataGrid x:Name="DgPuertasHerrajes"/></Border>
                    </TabItem>
                    <TabItem Header="Puertas Cantidad">
                        <Border Style="{StaticResource Card}"><DataGrid x:Name="DgPuertasCantidad"/></Border>
                    </TabItem>
                    <TabItem Header="Tubos Metálicos">
                        <Border Style="{StaticResource Card}"><DataGrid x:Name="DgTubos"/></Border>
                    </TabItem>
                    <TabItem Header="Áreas">
                        <Border Style="{StaticResource Card}"><DataGrid x:Name="DgMamparas"/></Border>
                    </TabItem>
                </TabControl>

                <!-- Divisor arrastrable para cambiar el alto del previsualizador -->
                <GridSplitter x:Name="PreviewSplitter" Grid.Row="1" Height="8"
                              HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                              Background="#262626" ResizeBehavior="PreviousAndNext"
                              ResizeDirection="Rows" Visibility="Collapsed"
                              ToolTip="Arrastra para cambiar el alto"/>

                <!-- Previsualizador de datos cargados (crudos), redimensionable -->
                <Border x:Name="PreviewPanel" Grid.Row="2" Style="{StaticResource Card}"
                        Margin="0,2,0,0" Visibility="Collapsed">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="6,4,6,8">
                            <TextBlock x:Name="LblPreview" Text="Datos cargados"
                                       FontWeight="SemiBold" Foreground="{StaticResource TextMuted}"
                                       FontSize="12" VerticalAlignment="Center"/>
                            <Button x:Name="BtnPreviewClose" Style="{StaticResource DotButton}"
                                    Content="&#xE8BB;" HorizontalAlignment="Right"
                                    Click="Preview_Click" ToolTip="Ocultar"/>
                        </Grid>
                        <DataGrid x:Name="DgPreview"/>
                    </DockPanel>
                </Border>

                <!-- ===== Aviso sutil cuando aún no hay TXT cargados ===== -->
                <StackPanel x:Name="HintVacio" Grid.Row="0" IsHitTestVisible="False"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Panel.ZIndex="5">
                    <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="34"
                               Foreground="#3A3A3A" HorizontalAlignment="Center"/>
                    <TextBlock Text="Puedes arrastrar tus archivos .txt aquí"
                               Foreground="#5C5C5C" FontSize="14" FontWeight="Regular"
                               HorizontalAlignment="Center" Margin="0,12,0,0"/>
                    <TextBlock Text="o usa el botón Cargar"
                               Foreground="#444444" FontSize="11"
                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- ===== Overlay de cálculo: spinner peach que se vuelve check ===== -->
                <Grid x:Name="SpinnerOverlay" Grid.Row="0" Grid.RowSpan="3"
                      Background="#AA060606" Visibility="Collapsed" Panel.ZIndex="10">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid Width="72" Height="72">
                            <Ellipse Width="56" Height="56" Stroke="#2E2E2E" StrokeThickness="4"/>
                            <Ellipse x:Name="SpinArc" Width="56" Height="56"
                                     Stroke="{StaticResource Accent}" StrokeThickness="4"
                                     StrokeDashArray="10 100" StrokeDashCap="Round"
                                     RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <RotateTransform x:Name="SpinRotate"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                            <Path x:Name="CheckPath" Stroke="{StaticResource Accent}" StrokeThickness="5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Data="M 21,37 L 32,48 L 52,25" Opacity="0"
                                  RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform>
                                    <ScaleTransform x:Name="CheckScale" ScaleX="0.6" ScaleY="0.6"/>
                                </Path.RenderTransform>
                            </Path>
                        </Grid>
                        <TextBlock x:Name="LblSpinner" Text="Calculando…" Margin="0,14,0,0"
                                   HorizontalAlignment="Center" FontSize="13" FontWeight="Medium"
                                   Foreground="{StaticResource TextPrimary}"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>

        <!-- ===== Overlay de arrastrar y soltar archivos (cubre todo el panel) ===== -->
        <Grid x:Name="DropOverlay" Background="#C8000000"
              Visibility="Collapsed" IsHitTestVisible="False" Panel.ZIndex="50">
            <Rectangle Margin="34" RadiusX="22" RadiusY="22" Fill="#12E07B5B"
                       Stroke="{StaticResource Accent}" StrokeThickness="2.5"
                       StrokeDashArray="6 4" StrokeDashCap="Round"/>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="54"
                           Foreground="{StaticResource Accent}" HorizontalAlignment="Center"/>
                <TextBlock Text="Suelta aquí tus archivos .txt" FontSize="18" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimary}" Margin="0,16,0,0"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Se cargan igual que con el botón Cargar" FontSize="12"
                           Foreground="{StaticResource TextMuted}" Margin="0,6,0,0"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
