<UserControl x:Class="arquitectSoft.View.Wpf.Panels.ComponentePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vw="clr-namespace:arquitectSoft.View.Wpf"
             xmlns:pn="clr-namespace:arquitectSoft.View.Wpf.Panels"
             Background="Transparent">

    <UserControl.Resources>
        <FontFamily x:Key="Jakarta">pack://application:,,,/Resources/Fonts/#Plus Jakarta Sans</FontFamily>
        <SolidColorBrush x:Key="Panel"       Color="#1E1E1E"/>
        <SolidColorBrush x:Key="PanelBorder" Color="#2F2F2F"/>
        <SolidColorBrush x:Key="InputDark"   Color="#0E0E0E"/>
        <SolidColorBrush x:Key="Accent"      Color="#E07B5B"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#ECECEC"/>
        <SolidColorBrush x:Key="TextMuted"   Color="#8C8C8C"/>

        <Style x:Key="Field" TargetType="TextBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="{StaticResource InputDark}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="CaretBrush" Value="{StaticResource Accent}"/>
            <Setter Property="SelectionBrush" Value="{StaticResource Accent}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="13,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd" CornerRadius="10" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Cap" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Margin" Value="3,0,0,5"/>
        </Style>

        <!-- ComboBox oscuro (encabezado Acabado) -->
        <Style x:Key="DarkComboItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Padding" Value="11,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#33E07B5B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DarkCombo" TargetType="ComboBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboItem}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="tb" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="bd" CornerRadius="10" Background="{StaticResource InputDark}"
                                                BorderBrush="{StaticResource PanelBorder}" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="30"/>
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter Grid.Column="0" Margin="13,0,0,0" VerticalAlignment="Center"
                                                                  Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource AncestorType=ComboBox}}"/>
                                                <TextBlock Grid.Column="1" Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="8"
                                                           Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True"
                                   Focusable="False" PopupAnimation="Slide">
                                <Border Background="#1B1B1B" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1"
                                        CornerRadius="8" MaxHeight="280"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer><ItemsPresenter/></ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- CheckBox cristal (encabezado Especial) -->
        <Style x:Key="DarkCheck" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="box" Width="20" Height="20" CornerRadius="6"
                                    Background="{StaticResource InputDark}" BorderBrush="{StaticResource PanelBorder}"
                                    BorderThickness="1" VerticalAlignment="Center">
                                <TextBlock x:Name="ck" Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                           Foreground="#201712" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="box" Property="Background" Value="{StaticResource Accent}"/>
                                <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                <Setter TargetName="ck" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox oscuro COMPACTO para edición dentro de las grillas -->
        <Style x:Key="GridCombo" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboItem}"/>
            <Setter Property="ItemTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding Descripcion}" Foreground="{StaticResource TextPrimary}"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="tb" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="bd" CornerRadius="6" Background="{StaticResource InputDark}"
                                                BorderBrush="{StaticResource PanelBorder}" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="22"/>
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter Grid.Column="0" Margin="9,0,0,0" VerticalAlignment="Center"
                                                                  Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource AncestorType=ComboBox}}"/>
                                                <TextBlock Grid.Column="1" Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="7"
                                                           Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True"
                                   Focusable="False" PopupAnimation="Slide">
                                <Border Background="#1F1F1F" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1"
                                        CornerRadius="8" Padding="3" MaxHeight="260"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <Border.Effect><DropShadowEffect Color="Black" BlurRadius="12" ShadowDepth="0" Opacity="0.5"/></Border.Effect>
                                    <ScrollViewer><ItemsPresenter/></ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox oscuro EDITABLE para la celda Mecanizado: al entrar en edición (doble
             clic o Enter) se puede escribir directamente y la lista salta al mecanizado que
             empieza igual. Necesita la parte PART_EditableTextBox, que GridCombo no tiene. -->
        <Style x:Key="GridComboEdit" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="IsEditable" Value="True"/>
            <!-- Búsqueda por subcadena hecha a mano (AplicarFiltroMecanizado): la de WPF es por
                 prefijo y además reescribe lo tecleado. -->
            <Setter Property="IsTextSearchEnabled" Value="False"/>
            <Setter Property="IsTextSearchCaseSensitive" Value="False"/>
            <Setter Property="StaysOpenOnEdit" Value="True"/>
            <!-- DisplayMemberPath (no ItemTemplate): un combo editable saca el texto de aquí. -->
            <Setter Property="DisplayMemberPath" Value="Descripcion"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboItem}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="bd" CornerRadius="6" Background="{StaticResource InputDark}"
                                    BorderBrush="{StaticResource Accent}" BorderThickness="1"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="22"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="PART_EditableTextBox" Grid.Column="0"
                                         Margin="8,0,0,0" Padding="0" BorderThickness="0"
                                         Background="Transparent" Foreground="{StaticResource TextPrimary}"
                                         CaretBrush="{StaticResource Accent}" SelectionBrush="{StaticResource Accent}"
                                         VerticalContentAlignment="Center"/>
                                <ToggleButton x:Name="tb" Grid.Column="1" Focusable="False" ClickMode="Press"
                                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="Transparent">
                                                <TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="7"
                                                           Foreground="{StaticResource TextMuted}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                            </Grid>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True"
                                   Focusable="False" PopupAnimation="Slide">
                                <Border Background="#1F1F1F" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1"
                                        CornerRadius="8" Padding="3" MaxHeight="260"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <Border.Effect><DropShadowEffect Color="Black" BlurRadius="12" ShadowDepth="0" Opacity="0.5"/></Border.Effect>
                                    <ScrollViewer><ItemsPresenter/></ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Celda Mecanizado (sin edición): combo de solo lectura sobre el catálogo COMPLETO.
             No es hit-testable para que el clic lo reciba la celda y arranque la edición. -->
        <DataTemplate x:Key="MecCelda">
            <ComboBox Style="{StaticResource GridCombo}" IsHitTestVisible="False" Focusable="False"
                      ItemsSource="{Binding MecanizadosTodos, RelativeSource={RelativeSource AncestorType=pn:ComponentePanel}}"
                      SelectedValuePath="Id"
                      SelectedValue="{Binding Cod_Mecanizado, Mode=OneWay}"/>
        </DataTemplate>

        <!-- Celda Mecanizado en edición: combo buscador. Va contra una vista APARTE del catálogo
             (MecanizadosFiltrados) para que el filtro que se aplica al teclear no vacíe los combos
             de las demás filas, que miran la lista completa. -->
        <DataTemplate x:Key="MecEdicion">
            <ComboBox Style="{StaticResource GridComboEdit}"
                      ItemsSource="{Binding MecanizadosFiltrados, RelativeSource={RelativeSource AncestorType=pn:ComponentePanel}}"
                      SelectedValuePath="Id"
                      SelectedValue="{Binding Cod_Mecanizado, UpdateSourceTrigger=PropertyChanged}"
                      Loaded="MecanizadoCombo_Loaded" Unloaded="MecanizadoCombo_Unloaded"/>
        </DataTemplate>

        <!-- CheckBox cristal para celdas de grilla (solo la casilla, centrada) -->
        <Style x:Key="GridCheck" TargetType="CheckBox">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="box" Width="18" Height="18" CornerRadius="5"
                                Background="{StaticResource InputDark}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1">
                            <TextBlock x:Name="ck" Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                       Foreground="#201712" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="box" Property="Background" Value="{StaticResource Accent}"/>
                                <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                <Setter TargetName="ck" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botón-icono (glifo Segoe MDL2 + texto debajo; hover peach + zoom) -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <StackPanel x:Name="sp" Background="Transparent" HorizontalAlignment="Center" Width="78">
                            <TextBlock x:Name="ico" Text="{TemplateBinding Tag}" FontFamily="Segoe MDL2 Assets"
                                       FontSize="22" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center"
                                       RenderTransformOrigin="0.5,0.5">
                                <TextBlock.RenderTransform><ScaleTransform x:Name="icoScale" ScaleX="1" ScaleY="1"/></TextBlock.RenderTransform>
                            </TextBlock>
                            <TextBlock Text="{TemplateBinding Content}" Foreground="{StaticResource TextMuted}" FontSize="11.5"
                                       FontWeight="Medium" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ico" Property="Foreground" Value="{StaticResource Accent}"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard><Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="icoScale" Storyboard.TargetProperty="ScaleX" To="1.14" Duration="0:0:0.12"/>
                                        <DoubleAnimation Storyboard.TargetName="icoScale" Storyboard.TargetProperty="ScaleY" To="1.14" Duration="0:0:0.12"/>
                                    </Storyboard></BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard><Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="icoScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.12"/>
                                        <DoubleAnimation Storyboard.TargetName="icoScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.12"/>
                                    </Storyboard></BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="ico" Property="Foreground" Value="#C96A4C"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Ghost" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="MinWidth" Value="92"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="10" Background="Transparent"
                                BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" Padding="14,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1C1C1C"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Scrollbar moderna ===== -->
        <Style x:Key="ScrollThumb" TargetType="Thumb">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="t" CornerRadius="5" Background="#3C3C3C" Margin="2">
                            <Border.Effect><DropShadowEffect Color="Black" BlurRadius="5" ShadowDepth="0" Opacity="0.6"/></Border.Effect>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="t" Property="Background" Value="#565656"/></Trigger>
                            <Trigger Property="IsDragging" Value="True"><Setter TargetName="t" Property="Background" Value="{StaticResource Accent}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ScrollPage" TargetType="RepeatButton">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="#14000000">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageUpCommand"/></Track.DecreaseRepeatButton>
                                <Track.Thumb><Thumb Style="{StaticResource ScrollThumb}" MinHeight="30"/></Track.Thumb>
                                <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageDownCommand"/></Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="Height" Value="12"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Grid Background="#14000000">
                                    <Track x:Name="PART_Track">
                                        <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageLeftCommand"/></Track.DecreaseRepeatButton>
                                        <Track.Thumb><Thumb Style="{StaticResource ScrollThumb}" MinWidth="30"/></Track.Thumb>
                                        <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageRightCommand"/></Track.IncreaseRepeatButton>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ===== DataGrid oscuro ===== -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#262626"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
            <Setter Property="BorderBrush" Value="#363636"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border x:Name="bd" Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#3DE07B5B"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsEditing" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#0E0E0E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="FontSize" Value="12"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#241B12"/></Trigger>
            </Style.Triggers>
        </Style>

        <!-- Fila de la grilla genérica: se pinta verde si tiene Asignación de Puertas -->
        <vw:PuertaABrushConverter x:Key="PuertaBrush"/>
        <Style x:Key="FilaGenerica" TargetType="DataGridRow">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="{Binding Asignacion_puertas, Converter={StaticResource PuertaBrush}}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#241B12"/></Trigger>
            </Style.Triggers>
        </Style>

        <!-- Menú contextual oscuro (acciones por fila) -->
        <Style x:Key="DarkMenuItem" TargetType="MenuItem">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="bd" Property="Background" Value="#33E07B5B"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ContextMenu">
            <Setter Property="HasDropShadow" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="#1F1F1F" BorderBrush="{StaticResource PanelBorder}"
                                BorderThickness="1" CornerRadius="10" Padding="5">
                            <Border.Effect>
                                <DropShadowEffect Color="Black" BlurRadius="14" ShadowDepth="0" Opacity="0.55"/>
                            </Border.Effect>
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <ContextMenu x:Key="MenuGenerico">
            <MenuItem Header="Asignación Puertas" Style="{StaticResource DarkMenuItem}" Click="AsignarPuertas_Click"/>
            <MenuItem Header="Asignar Mecanizado…" Style="{StaticResource DarkMenuItem}" Click="AsignarMecanizado_Click"/>
            <MenuItem Header="Quitar Mecanizado" Style="{StaticResource DarkMenuItem}" Click="QuitarMecanizado_Click"/>
            <MenuItem Header="Datos de anchura (Ambas)…" Style="{StaticResource DarkMenuItem}" Click="Anchura_Click"/>
        </ContextMenu>
    </UserControl.Resources>

    <!-- Contenido (el chrome de ventana y el liquid glass los aporta MdiChild) -->
    <Grid TextElement.FontFamily="{StaticResource Jakarta}" TextElement.Foreground="{StaticResource TextPrimary}"
          Margin="16,12,16,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- barra (campos + iconos) -->
            <RowDefinition Height="*"/>      <!-- grilla genérica -->
            <RowDefinition Height="Auto"/>   <!-- grilla especial -->
            <RowDefinition Height="Auto"/>   <!-- estado -->
        </Grid.RowDefinitions>

        <!-- ===== Barra opaca: campos + iconos de acción ===== -->
        <Border Grid.Row="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource PanelBorder}"
                BorderThickness="1" CornerRadius="16" Padding="16,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Campos -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="260"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Text="CÓDIGO" Style="{StaticResource Cap}"/>
                        <TextBox x:Name="TxtCodigo" Style="{StaticResource Field}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,12,0">
                        <TextBlock Text="DESCRIPCIÓN" Style="{StaticResource Cap}"/>
                        <TextBox x:Name="TxtDescripcion" Style="{StaticResource Field}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="0,0,16,0">
                        <TextBlock Text="ACABADO" Style="{StaticResource Cap}"/>
                        <ComboBox x:Name="CmbAcabado" Style="{StaticResource DarkCombo}" SelectedValuePath="Id_Acabado">
                            <ComboBox.ItemTemplate>
                                <DataTemplate><TextBlock Text="{Binding Descripcion}" Foreground="{StaticResource TextPrimary}"/></DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <CheckBox x:Name="ChkEspecial" Grid.Column="3" Style="{StaticResource DarkCheck}"
                              Content="Especial" VerticalAlignment="Bottom" Margin="0,0,0,10"
                              Checked="ChkEspecial_Changed" Unchecked="ChkEspecial_Changed"/>
                </Grid>

                <!-- Iconos de acción -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,14,0,0">
                    <Button x:Name="BtnNuevo" Style="{StaticResource IconButton}" Tag="&#xE710;" Content="Nuevo" Click="Nuevo_Click"/>
                    <Button x:Name="BtnGuardar" Style="{StaticResource IconButton}" Tag="&#xE74E;" Content="Guardar" Click="Guardar_Click"/>
                    <Button x:Name="BtnBuscar" Style="{StaticResource IconButton}" Tag="&#xE721;" Content="Buscar" Click="Buscar_Click"/>
                    <Button x:Name="BtnEliminar" Style="{StaticResource IconButton}" Tag="&#xE74D;" Content="Eliminar" Click="Eliminar_Click"/>
                    <Button x:Name="BtnDuplicar" Style="{StaticResource IconButton}" Tag="&#xE8C8;" Content="Duplicar" Click="Duplicar_Click"/>
                    <Button x:Name="BtnCancelar" Style="{StaticResource IconButton}" Tag="&#xE711;" Content="Cancelar" Click="Cancelar_Click"/>
                    <Button x:Name="BtnCheck" Style="{StaticResource IconButton}" Tag="&#xE73E;" Content="Verificar" Click="Check_Click"/>
                    <Button x:Name="BtnAgregar" Style="{StaticResource IconButton}" Tag="&#xECC8;" Content="Subcomp." Click="Agregar_Click"/>
                    <Button x:Name="BtnBorrar" Style="{StaticResource IconButton}" Tag="&#xE738;" Content="Quitar fila" Click="Borrar_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== Grilla genérica ===== -->
        <Grid Grid.Row="1" Margin="0,12,0,0">
            <!-- Sombra pre-renderizada (9-slice) en vez de DropShadowEffect: coste ~0 al maximizar -->
            <vw:SoftShadow Margin="-30" Opacity="0.6"/>
            <!-- Base opaca (la tarjeta es semi-transparente y necesita fondo solido) -->
            <Border CornerRadius="14" Background="#FF0E0E10" IsHitTestVisible="False"/>
            <Border CornerRadius="14" Background="#B0151515" BorderThickness="1.1" Padding="6">
                <Border.BorderBrush>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#59FFFFFF" Offset="0"/>
                        <GradientStop Color="#14FFFFFF" Offset="0.32"/>
                        <GradientStop Color="#05FFFFFF" Offset="0.6"/>
                        <GradientStop Color="#1FFFFFFF" Offset="1"/>
                    </LinearGradientBrush>
                </Border.BorderBrush>
                <DataGrid x:Name="GridComponente" AutoGenerateColumns="False"
                          CanUserAddRows="False" CanUserDeleteRows="False"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#262626" BorderThickness="0" Background="Transparent"
                          RowHeaderWidth="0"
                          SelectionMode="Extended" SelectionUnit="FullRow"
                          RowStyle="{StaticResource FilaGenerica}"
                          ContextMenu="{StaticResource MenuGenerico}"
                          ContextMenuOpening="GridComponente_ContextMenuOpening"
                          CellEditEnding="GridComponente_CellEditEnding"
                          Foreground="{StaticResource TextPrimary}"/>
            </Border>
        </Grid>

        <!-- ===== Grilla especial ===== -->
        <Border x:Name="EspPanel" Grid.Row="2" Margin="0,12,0,0" Height="190" CornerRadius="14"
                Background="#B0151515" BorderThickness="1.1" Padding="6" Visibility="Collapsed">
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#59FFFFFF" Offset="0"/>
                    <GradientStop Color="#14FFFFFF" Offset="0.32"/>
                    <GradientStop Color="#05FFFFFF" Offset="0.6"/>
                    <GradientStop Color="#1FFFFFFF" Offset="1"/>
                </LinearGradientBrush>
            </Border.BorderBrush>
            <DataGrid x:Name="GridComponenteEsp" AutoGenerateColumns="False"
                      CanUserAddRows="False" CanUserDeleteRows="False"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#262626" BorderThickness="0" Background="Transparent"
                      RowBackground="Transparent" AlternatingRowBackground="#1B1B1B" RowHeaderWidth="0"
                      SelectionMode="Extended" SelectionUnit="FullRow"
                      Foreground="{StaticResource TextPrimary}"/>
        </Border>

        <TextBlock x:Name="LblEstado" Grid.Row="3" Margin="4,10,4,0"
                   Foreground="{StaticResource TextMuted}" FontSize="11.5" TextWrapping="Wrap"/>
    </Grid>
</UserControl>
