<UserControl x:Class="arquitectSoft.View.Wpf.Panels.MiCuentaPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <UserControl.Resources>
        <FontFamily x:Key="Jakarta">pack://application:,,,/Resources/Fonts/#Plus Jakarta Sans</FontFamily>
        <SolidColorBrush x:Key="PanelBorder" Color="#2F2F2F"/>
        <SolidColorBrush x:Key="InputDark"   Color="#0E0E0E"/>
        <SolidColorBrush x:Key="Accent"      Color="#E07B5B"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#ECECEC"/>
        <SolidColorBrush x:Key="TextMuted"   Color="#8C8C8C"/>

        <!-- Caja de contraseña oscura (mismo look que las cajas de texto) -->
        <Style x:Key="Field" TargetType="PasswordBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="{StaticResource InputDark}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="CaretBrush" Value="{StaticResource Accent}"/>
            <Setter Property="SelectionBrush" Value="{StaticResource Accent}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="13,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="bd" CornerRadius="10" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Cap" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Margin" Value="2,0,0,6"/>
        </Style>

        <Style x:Key="Primary" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#2A1810"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="12" Padding="16,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#F2966D" Offset="0"/>
                                    <GradientStop Color="#E67E5C" Offset="0.5"/>
                                    <GradientStop Color="#C9684A" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#E07B5B" BlurRadius="16" ShadowDepth="0" Opacity="0.6"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid TextElement.FontFamily="{StaticResource Jakarta}"
          TextElement.Foreground="{StaticResource TextPrimary}"
          Margin="22,18,22,18">
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="360">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Mi cuenta" FontSize="19" FontWeight="Bold" Margin="0,0,0,2"/>
            <TextBlock Grid.Row="1" x:Name="LblUsuario" Foreground="{StaticResource TextMuted}"
                       FontSize="12" Margin="0,0,0,18"/>

            <TextBlock Grid.Row="2" Style="{StaticResource Cap}" Text="Contraseña actual"/>
            <PasswordBox Grid.Row="3" x:Name="TxtActual" Style="{StaticResource Field}" Margin="0,0,0,12"/>

            <TextBlock Grid.Row="4" Style="{StaticResource Cap}" Text="Nueva contraseña"/>
            <PasswordBox Grid.Row="5" x:Name="TxtNueva" Style="{StaticResource Field}" Margin="0,0,0,12"/>

            <StackPanel Grid.Row="6">
                <TextBlock Style="{StaticResource Cap}" Text="Repetir nueva contraseña"/>
                <PasswordBox x:Name="TxtConfirmar" Style="{StaticResource Field}"/>
            </StackPanel>

            <StackPanel Grid.Row="7" Margin="0,18,0,0">
                <TextBlock x:Name="LblEstado" Foreground="{StaticResource Accent}" FontSize="11.5"
                           TextWrapping="Wrap" Margin="2,0,0,10" Visibility="Collapsed"/>
                <Button x:Name="BtnGuardar" Style="{StaticResource Primary}" Content="Cambiar contraseña" Click="Guardar_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
