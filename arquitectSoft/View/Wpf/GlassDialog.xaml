<Window x:Class="arquitectSoft.View.Wpf.GlassDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="arquitectSoft"
        SizeToContent="Height"
        Width="430"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        AllowsTransparency="False"
        Background="Transparent"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" CornerRadius="0"
                      GlassFrameThickness="-1" ResizeBorderThickness="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <FontFamily x:Key="Jakarta">pack://application:,,,/Resources/Fonts/#Plus Jakarta Sans</FontFamily>
        <SolidColorBrush x:Key="Accent"      Color="#E07B5B"/>
        <SolidColorBrush x:Key="PanelBorder" Color="#2F2F2F"/>
        <SolidColorBrush x:Key="InputDark"   Color="#0E0E0E"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#ECECEC"/>
        <SolidColorBrush x:Key="TextMuted"   Color="#8C8C8C"/>

        <!-- Botón primario peach -->
        <Style x:Key="Primary" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#201712"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="MinWidth" Value="96"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="bd" CornerRadius="11" Padding="16,0" RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform><ScaleTransform x:Name="sc" ScaleX="1" ScaleY="1"/></Border.RenderTransform>
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#F2966D" Offset="0"/>
                                        <GradientStop Color="#E67E5C" Offset="0.5"/>
                                        <GradientStop Color="#C9684A" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Grid>
                                    <Border x:Name="gloss" CornerRadius="10" Margin="1.2" IsHitTestVisible="False">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#42FFFFFF" Offset="0"/>
                                                <GradientStop Color="#0CFFFFFF" Offset="0.5"/>
                                                <GradientStop Color="#00FFFFFF" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <Border CornerRadius="11" BorderThickness="1" IsHitTestVisible="False">
                                <Border.BorderBrush>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#66FFFFFF" Offset="0"/>
                                        <GradientStop Color="#22FFFFFF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.BorderBrush>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#E07B5B" BlurRadius="16" ShadowDepth="0" Opacity="0.6"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard><Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleX" To="0.93" Duration="0:0:0.09"/>
                                        <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleY" To="0.86" Duration="0:0:0.09"/>
                                        <DoubleAnimation Storyboard.TargetName="gloss" Storyboard.TargetProperty="Opacity" To="0.35" Duration="0:0:0.09"/>
                                    </Storyboard></BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard><Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.5"><DoubleAnimation.EasingFunction><ElasticEase Oscillations="2" Springiness="5" EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.5"><DoubleAnimation.EasingFunction><ElasticEase Oscillations="2" Springiness="5" EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="gloss" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.3"/>
                                    </Storyboard></BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botón secundario (contorno) -->
        <Style x:Key="Ghost" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="MinWidth" Value="96"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="9" Background="Transparent"
                                BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" Padding="16,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1C1C1C"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Field" TargetType="TextBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Background" Value="{StaticResource InputDark}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="CaretBrush" Value="{StaticResource Accent}"/>
            <Setter Property="SelectionBrush" Value="{StaticResource Accent}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="11,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd" CornerRadius="9" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Cap" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Margin" Value="3,0,0,5"/>
        </Style>

        <!-- Botón "elegir del catálogo" junto a cada campo de acabado -->
        <Style x:Key="PickBtn" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="9" Background="#14E07B5B"
                                BorderBrush="{StaticResource Accent}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Accent}"/>
                                <Setter Property="Foreground" Value="#201712"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#C96A4C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- El tinte translúcido lo da el Background de la ventana; aquí sólo un
         contorno sutil + un reflejo de cristal para que se vea brillante. -->
    <Border x:Name="FrameRim" Background="#CC000000" CornerRadius="14"
            BorderBrush="#3DFFFFFF" BorderThickness="1"
            RenderTransformOrigin="0.5,0.5"
            TextElement.FontFamily="{StaticResource Jakarta}"
            TextElement.Foreground="{StaticResource TextPrimary}">
        <Border.RenderTransform>
            <ScaleTransform x:Name="WinScale" ScaleX="1" ScaleY="1"/>
        </Border.RenderTransform>
        <Grid>
            <!-- Brillo de cristal (reflejo desde la esquina superior) -->
            <Border IsHitTestVisible="False" CornerRadius="13">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0.1,0" EndPoint="0.6,1">
                        <GradientStop Color="#22FFFFFF" Offset="0"/>
                        <GradientStop Color="#0CFFFFFF" Offset="0.22"/>
                        <GradientStop Color="#00FFFFFF" Offset="0.5"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
        <Grid Margin="26,22,26,22" MouseLeftButtonDown="Cabecera_Drag">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                <Border Width="9" Height="9" CornerRadius="3" Background="{StaticResource Accent}"
                        VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock x:Name="LblTitulo" Text="arquitectSoft" FontSize="14" FontWeight="Bold"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <TextBlock x:Name="LblMensaje" Grid.Row="1" TextWrapping="Wrap" FontSize="13"
                       Foreground="{StaticResource TextPrimary}" Margin="0,0,0,4" LineHeight="20"/>

            <!-- Área de entrada (sólo modo acabado) -->
            <StackPanel x:Name="PanelInput" Grid.Row="2" Margin="0,14,0,0" Visibility="Collapsed">
                <TextBlock Text="ACABADO ACTUAL (origen)" Style="{StaticResource Cap}"/>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource PickBtn}"
                            Content="&#xE71D;" Click="Buscar1_Click" ToolTip="Elegir de la lista de acabados"/>
                    <TextBox x:Name="TxtAcabado1" Style="{StaticResource Field}" Margin="0,0,8,0"/>
                </DockPanel>
                <TextBlock Text="ACABADO NUEVO (destino)" Style="{StaticResource Cap}" Margin="3,14,0,5"/>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource PickBtn}"
                            Content="&#xE71D;" Click="Buscar2_Click" ToolTip="Elegir de la lista de acabados"/>
                    <TextBox x:Name="TxtAcabado2" Style="{StaticResource Field}" Margin="0,0,8,0"/>
                </DockPanel>
                <TextBlock Text="Pulsa el icono para elegir de la lista, o escribe CÓDIGO-DESCRIPCIÓN."
                           Foreground="#7A7A7A" FontSize="10" Margin="3,8,0,0" TextWrapping="Wrap"/>
            </StackPanel>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                <Button x:Name="BtnSecundario" Style="{StaticResource Ghost}" Content="Cancelar"
                        Margin="0,0,10,0" Click="Secundario_Click"/>
                <Button x:Name="BtnPrimario" Style="{StaticResource Primary}" Content="Aceptar"
                        Click="Primario_Click" IsDefault="True"/>
            </StackPanel>
        </Grid>
        </Grid>
    </Border>
</Window>
