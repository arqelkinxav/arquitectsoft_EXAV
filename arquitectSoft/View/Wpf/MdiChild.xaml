<UserControl x:Class="arquitectSoft.View.Wpf.MdiChild"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vw="clr-namespace:arquitectSoft.View.Wpf"
             MinWidth="320" MinHeight="200">
    <UserControl.Resources>
        <FontFamily x:Key="Jakarta">pack://application:,,,/Resources/Fonts/#Plus Jakarta Sans</FontFamily>
        <SolidColorBrush x:Key="Accent" Color="#E07B5B"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#ECECEC"/>

        <!-- Botón de control de ventana (minimizar / maximizar / cerrar) estilo macOS -->
        <Style x:Key="WinDot" TargetType="Button">
            <Setter Property="Width" Value="13"/><Setter Property="Height" Value="13"/>
            <Setter Property="Margin" Value="5,0"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#0B0B0B"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/><Setter Property="FontSize" Value="7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid><Ellipse x:Name="dot" Fill="#3A3A3A"/>
                            <ContentPresenter x:Name="g" Opacity="0" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="dot" Property="Fill" Value="#E07B5B"/>
                                <Setter TargetName="g" Property="Opacity" Value="1"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Plantilla de Thumb transparente reutilizable para los agarres de redimensión -->
        <ControlTemplate x:Key="ThumbTransparente" TargetType="Thumb">
            <Border Background="Transparent"/>
        </ControlTemplate>
    </UserControl.Resources>

    <!-- Root: halo pre-renderizado (9-slice) detras + marco de cristal (ya sin DropShadowEffect) -->
    <Grid>
    <vw:SoftShadow Margin="-22" Opacity="0.55"/>
    <Border x:Name="Frame" CornerRadius="12" Background="Transparent" BorderThickness="1.2"
            TextElement.FontFamily="{StaticResource Jakarta}" TextElement.Foreground="{StaticResource TextPrimary}">
        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#73FFFFFF" Offset="0"/><GradientStop Color="#1FFFFFFF" Offset="0.3"/>
                <GradientStop Color="#05FFFFFF" Offset="0.6"/><GradientStop Color="#26FFFFFF" Offset="1"/>
            </LinearGradientBrush>
        </Border.BorderBrush>

        <!-- Recorte redondeado: evita que el shader del cristal rellene las esquinas
             y asome por fuera del marco. El Clip se ajusta por código al tamaño. -->
        <Grid x:Name="Recorte" SizeChanged="Recorte_SizeChanged">
            <!-- ===== Capas de LIQUID GLASS (refracción del fondo del escritorio) ===== -->
            <!-- Fondo refractado por el shader; lo monta el código (VisualBrush del wallpaper). -->
            <Rectangle x:Name="GlassBackdrop" RadiusX="11" RadiusY="11" IsHitTestVisible="False"/>
            <!-- Tinte oscuro encima del cristal -->
            <Rectangle Fill="#9E000000" RadiusX="11" RadiusY="11" IsHitTestVisible="False"/>
            <!-- Brillo de cristal diagonal -->
            <Border CornerRadius="11" IsHitTestVisible="False">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0.15,0" EndPoint="0.55,1">
                        <GradientStop Color="#1FFFFFFF" Offset="0"/>
                        <GradientStop Color="#0BFFFFFF" Offset="0.18"/>
                        <GradientStop Color="#00FFFFFF" Offset="0.45"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <!-- ===== Contenido ===== -->
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="*"/></Grid.RowDefinitions>

                <!-- Barra de título (arrastrable) -->
                <Border Grid.Row="0" Background="#59121214" CornerRadius="11,11,0,0">
                    <Grid>
                        <Thumb x:Name="DragThumb" Background="Transparent" Opacity="0" Template="{StaticResource ThumbTransparente}"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0" IsHitTestVisible="False">
                            <Border Width="9" Height="9" CornerRadius="3" Background="{StaticResource Accent}" Margin="0,0,9,0"/>
                            <TextBlock x:Name="LblTitulo" Text="Ventana" FontSize="12.5" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0">
                            <Button x:Name="BtnMin" Style="{StaticResource WinDot}" Content="&#xE921;" Click="Minimizar_Click" ToolTip="Minimizar"/>
                            <Button x:Name="BtnMax" Style="{StaticResource WinDot}" Content="&#xE922;" Click="Maximizar_Click" ToolTip="Maximizar en el escritorio"/>
                            <Button x:Name="BtnClose" Style="{StaticResource WinDot}" Content="&#xE8BB;" Click="Cerrar_Click" ToolTip="Cerrar"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Contenido hospedado -->
                <ContentControl x:Name="Host" Grid.Row="1"/>
            </Grid>

            <!-- ===== Agarres de redimensión (4 lados + 4 esquinas) ===== -->
            <Grid x:Name="ResizeGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="6"/><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="6"/><RowDefinition Height="*"/><RowDefinition Height="6"/>
                </Grid.RowDefinitions>
                <!-- Esquinas -->
                <Thumb x:Name="RzTL" Grid.Row="0" Grid.Column="0" Cursor="SizeNWSE" Template="{StaticResource ThumbTransparente}"/>
                <Thumb x:Name="RzTR" Grid.Row="0" Grid.Column="2" Cursor="SizeNESW" Template="{StaticResource ThumbTransparente}"/>
                <Thumb x:Name="RzBL" Grid.Row="2" Grid.Column="0" Cursor="SizeNESW" Template="{StaticResource ThumbTransparente}"/>
                <Thumb x:Name="RzBR" Grid.Row="2" Grid.Column="2" Cursor="SizeNWSE" Template="{StaticResource ThumbTransparente}"/>
                <!-- Lados -->
                <Thumb x:Name="RzT" Grid.Row="0" Grid.Column="1" Cursor="SizeNS" Template="{StaticResource ThumbTransparente}"/>
                <Thumb x:Name="RzB" Grid.Row="2" Grid.Column="1" Cursor="SizeNS" Template="{StaticResource ThumbTransparente}"/>
                <Thumb x:Name="RzL" Grid.Row="1" Grid.Column="0" Cursor="SizeWE" Template="{StaticResource ThumbTransparente}"/>
                <Thumb x:Name="RzR" Grid.Row="1" Grid.Column="2" Cursor="SizeWE" Template="{StaticResource ThumbTransparente}"/>
            </Grid>
        </Grid>
    </Border>
    </Grid>
</UserControl>
