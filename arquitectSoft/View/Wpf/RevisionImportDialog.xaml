<Window x:Class="arquitectSoft.View.Wpf.RevisionImportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Revisión antes de importar"
        Height="620"
        Width="760"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        AllowsTransparency="False"
        Background="Transparent"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" CornerRadius="0"
                      GlassFrameThickness="-1" ResizeBorderThickness="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <FontFamily x:Key="Jakarta">pack://application:,,,/Resources/Fonts/#Plus Jakarta Sans</FontFamily>
        <SolidColorBrush x:Key="Accent"      Color="#E07B5B"/>
        <SolidColorBrush x:Key="PanelBorder" Color="#2F2F2F"/>
        <SolidColorBrush x:Key="InputDark"   Color="#0E0E0E"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#ECECEC"/>
        <SolidColorBrush x:Key="TextMuted"   Color="#8C8C8C"/>

        <Style x:Key="Primary" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#201712"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="MinWidth" Value="96"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="12" Padding="16,0" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform><ScaleTransform x:Name="sc" ScaleX="1" ScaleY="1"/></Border.RenderTransform>
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#F2966D" Offset="0"/><GradientStop Color="#E67E5C" Offset="0.5"/><GradientStop Color="#C9684A" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Effect">
                                    <Setter.Value><DropShadowEffect Color="#E07B5B" BlurRadius="16" ShadowDepth="0" Opacity="0.6"/></Setter.Value></Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions><BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleX" To="0.94" Duration="0:0:0.07"/>
                                    <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleY" To="0.94" Duration="0:0:0.07"/>
                                </Storyboard></BeginStoryboard></Trigger.EnterActions>
                                <Trigger.ExitActions><BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.28"><DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.4"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                                    <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.28"><DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.4"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                                </Storyboard></BeginStoryboard></Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Ghost" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="MinWidth" Value="96"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="10" Background="Transparent"
                                BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" Padding="14,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1C1C1C"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Un bloque del informe: barra de color segun gravedad, titulo y sus lineas. -->
        <DataTemplate x:Key="Bloque">
            <Border CornerRadius="12" Background="#7A0E0E0E" BorderBrush="{StaticResource PanelBorder}"
                    BorderThickness="1" Padding="0" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{Binding Color}" CornerRadius="12,0,0,12"/>

                    <StackPanel Grid.Column="1" Margin="14,11,14,12">
                        <TextBlock Text="{Binding Titulo}" FontSize="12.5" FontWeight="SemiBold"
                                   Foreground="{Binding Color}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Texto}" FontSize="11.5" LineHeight="17" Margin="0,6,0,0"
                                   Foreground="{StaticResource TextMuted}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Border x:Name="FrameRim" Background="#CC000000" CornerRadius="14"
            BorderBrush="#3DFFFFFF" BorderThickness="1"
            RenderTransformOrigin="0.5,0.5"
            TextElement.FontFamily="{StaticResource Jakarta}"
            TextElement.Foreground="{StaticResource TextPrimary}">
        <Border.RenderTransform>
            <ScaleTransform x:Name="WinScale" ScaleX="1" ScaleY="1"/>
        </Border.RenderTransform>
        <Grid>
            <!-- Brillo de cristal -->
            <Border IsHitTestVisible="False" CornerRadius="13">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0.1,0" EndPoint="0.6,1">
                        <GradientStop Color="#22FFFFFF" Offset="0"/>
                        <GradientStop Color="#0CFFFFFF" Offset="0.22"/>
                        <GradientStop Color="#00FFFFFF" Offset="0.5"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <Grid Margin="26,22,26,22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10"
                            MouseLeftButtonDown="Cabecera_Drag">
                    <Border Width="9" Height="9" CornerRadius="3" Background="{StaticResource Accent}"
                            VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="Revisión antes de importar" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock Grid.Row="1" x:Name="LblOrigen" TextWrapping="Wrap" FontSize="11.5" LineHeight="17"
                           Foreground="{StaticResource TextMuted}" Margin="0,0,0,12"/>

                <Border Grid.Row="2" x:Name="CajaTitular" CornerRadius="12" Padding="14,11"
                        Background="#7A0E0E0E" BorderThickness="1" Margin="0,0,0,14">
                    <TextBlock x:Name="LblTitular" TextWrapping="Wrap" FontSize="12.5" LineHeight="19"/>
                </Border>

                <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                    <ItemsControl x:Name="ListaBloques" ItemTemplate="{StaticResource Bloque}"/>
                </ScrollViewer>

                <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                    <Button x:Name="BtnCancelar" Style="{StaticResource Ghost}" Content="Cancelar"
                            Margin="0,0,10,0" Click="Cancelar_Click" IsCancel="True" IsDefault="True"/>
                    <Button x:Name="BtnImportar" Style="{StaticResource Primary}" Content="Importar de todas formas"
                            MinWidth="200" Click="Importar_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
