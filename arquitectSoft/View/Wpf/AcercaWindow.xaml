<Window x:Class="arquitectSoft.View.Wpf.AcercaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Acerca de"
        Width="500" Height="420"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="Transparent"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" CornerRadius="0"
                      GlassFrameThickness="-1" ResizeBorderThickness="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <FontFamily x:Key="Jakarta">pack://application:,,,/Resources/Fonts/#Plus Jakarta Sans</FontFamily>
        <SolidColorBrush x:Key="PanelBorder" Color="#2F2F2F"/>
        <SolidColorBrush x:Key="InputDark"   Color="#0E0E0E"/>
        <SolidColorBrush x:Key="Accent"      Color="#E07B5B"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#ECECEC"/>
        <SolidColorBrush x:Key="TextMuted"   Color="#8C8C8C"/>

        <Style x:Key="DotButton" TargetType="Button">
            <Setter Property="Width" Value="14"/>
            <Setter Property="Height" Value="14"/>
            <Setter Property="Margin" Value="5,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#0B0B0B"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="7"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="dot" Fill="#3A3A3A"/>
                            <ContentPresenter x:Name="g" Opacity="0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="dot" Property="Fill" Value="#E07B5B"/>
                                <Setter TargetName="g" Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Cap" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Medium"/>
        </Style>

        <Style x:Key="Primary" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#2A1810"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="12" Padding="16,0" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform><ScaleTransform x:Name="sc" ScaleX="1" ScaleY="1"/></Border.RenderTransform>
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#F2966D" Offset="0"/><GradientStop Color="#E67E5C" Offset="0.5"/><GradientStop Color="#C9684A" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Effect">
                                    <Setter.Value><DropShadowEffect Color="#E07B5B" BlurRadius="16" ShadowDepth="0" Opacity="0.6"/></Setter.Value></Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions><BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleX" To="0.94" Duration="0:0:0.07"/>
                                    <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleY" To="0.94" Duration="0:0:0.07"/>
                                </Storyboard></BeginStoryboard></Trigger.EnterActions>
                                <Trigger.ExitActions><BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.28"><DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.4"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                                    <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.28"><DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.4"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                                </Storyboard></BeginStoryboard></Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Marco de cristal -->
    <Border x:Name="FrameRim" CornerRadius="8" BorderThickness="1.1" Background="Transparent" RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform><ScaleTransform x:Name="WinScale" ScaleX="1" ScaleY="1"/></Border.RenderTransform>
        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#73FFFFFF" Offset="0"/>
                <GradientStop Color="#1FFFFFFF" Offset="0.28"/>
                <GradientStop Color="#05FFFFFF" Offset="0.55"/>
                <GradientStop Color="#26FFFFFF" Offset="1"/>
            </LinearGradientBrush>
        </Border.BorderBrush>

    <Grid TextElement.FontFamily="{StaticResource Jakarta}" TextElement.Foreground="{StaticResource TextPrimary}">
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Rectangle x:Name="GlassBackdrop" Grid.Row="0" Grid.RowSpan="2" IsHitTestVisible="False" RadiusX="7" RadiusY="7"/>
        <Rectangle Grid.Row="0" Grid.RowSpan="2" IsHitTestVisible="False" Fill="#9E000000" RadiusX="7" RadiusY="7"/>

        <Border Grid.Row="0" Grid.RowSpan="2" IsHitTestVisible="False" Panel.ZIndex="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0.15,0" EndPoint="0.55,1">
                    <GradientStop Color="#1FFFFFFF" Offset="0"/>
                    <GradientStop Color="#0BFFFFFF" Offset="0.18"/>
                    <GradientStop Color="#00FFFFFF" Offset="0.45"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <Grid Grid.Row="0" Background="#01000000">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                <Border Width="10" Height="10" CornerRadius="3" Background="{StaticResource Accent}" Margin="0,0,11,0"/>
                <TextBlock Text="Acerca de" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,18,0">
                <Button Style="{StaticResource DotButton}" Content="&#xE8BB;" Click="Cerrar_Click" ToolTip="Cerrar"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="24,8,24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
                <Border Width="44" Height="44" CornerRadius="12" Background="{StaticResource Accent}" Margin="0,0,14,0">
                    <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="#201712"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="LblProducto" Text="Producto" FontSize="18" FontWeight="Bold"/>
                    <TextBlock x:Name="LblVersion" Style="{StaticResource Cap}" Text="Versión"/>
                </StackPanel>
            </StackPanel>

            <TextBlock x:Name="LblEmpresa" Grid.Row="1" Style="{StaticResource Cap}" Margin="0,14,0,0"/>
            <TextBlock x:Name="LblCopyright" Grid.Row="2" Style="{StaticResource Cap}" Margin="0,4,0,0" TextWrapping="Wrap"/>

            <Border Grid.Row="3" Margin="0,14,0,0" CornerRadius="10" Background="#0E0E0E"
                    BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" Padding="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="LblDescripcion" Foreground="{StaticResource TextPrimary}" FontSize="12.5"
                               TextWrapping="Wrap" LineHeight="19"/>
                </ScrollViewer>
            </Border>

            <Button Grid.Row="4" Style="{StaticResource Primary}" Content="Aceptar" HorizontalAlignment="Right"
                    Margin="0,16,0,0" Click="Cerrar_Click" IsDefault="True"/>
        </Grid>
    </Grid>
    </Border>
</Window>
