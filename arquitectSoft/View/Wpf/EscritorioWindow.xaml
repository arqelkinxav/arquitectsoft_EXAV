<Window x:Class="arquitectSoft.View.Wpf.EscritorioWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="arquitectSoft"
        Width="1408" Height="770" MinWidth="900" MinHeight="600"
        WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="Manual"
        Background="#0A0A0C"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" CornerRadius="0" GlassFrameThickness="0" ResizeBorderThickness="6"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/View/Wpf/Estilos.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Botón-icono igual que en Análisis de Mamparas (icono + texto; hover peach + zoom) -->
            <Style x:Key="IconButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Margin" Value="0,6"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <StackPanel x:Name="sp" Background="Transparent" HorizontalAlignment="Center" Width="80">
                                <TextBlock x:Name="ico" Text="{TemplateBinding Tag}" FontFamily="Segoe MDL2 Assets"
                                           FontSize="23" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center"
                                           RenderTransformOrigin="0.5,0.5">
                                    <TextBlock.RenderTransform><ScaleTransform x:Name="icoScale" ScaleX="1" ScaleY="1"/></TextBlock.RenderTransform>
                                </TextBlock>
                                <TextBlock x:Name="lbl" Text="{TemplateBinding Content}" Foreground="{StaticResource TextMuted}"
                                           FontSize="11" FontWeight="Medium" HorizontalAlignment="Center" Margin="0,5,0,0"
                                           TextAlignment="Center" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ico" Property="Foreground" Value="{StaticResource Accent}"/>
                                    <Setter TargetName="lbl" Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                    <Trigger.EnterActions>
                                        <BeginStoryboard><Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="icoScale" Storyboard.TargetProperty="ScaleX" To="1.16" Duration="0:0:0.12"/>
                                            <DoubleAnimation Storyboard.TargetName="icoScale" Storyboard.TargetProperty="ScaleY" To="1.16" Duration="0:0:0.12"/>
                                        </Storyboard></BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard><Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="icoScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.12"/>
                                            <DoubleAnimation Storyboard.TargetName="icoScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.12"/>
                                        </Storyboard></BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True"><Setter TargetName="ico" Property="Foreground" Value="#C96A4C"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="WinDot" TargetType="Button">
                <Setter Property="Width" Value="14"/><Setter Property="Height" Value="14"/>
                <Setter Property="Margin" Value="5,0"/><Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Foreground" Value="#0B0B0B"/>
                <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/><Setter Property="FontSize" Value="7"/>
                <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid><Ellipse x:Name="dot" Fill="#3A3A3A"/>
                                <ContentPresenter x:Name="g" Opacity="0" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="dot" Property="Fill" Value="#E07B5B"/>
                                    <Setter TargetName="g" Property="Opacity" Value="1"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Botón de la barra de tareas (icono + título de cada ventana abierta) -->
            <Style x:Key="TaskButton" TargetType="Button">
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Margin" Value="4,0"/>
                <Setter Property="Height" Value="32"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" CornerRadius="9" Background="#26FFFFFF" Padding="10,0"
                                    BorderThickness="0,0,0,2" BorderBrush="{TemplateBinding BorderBrush}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock x:Name="ico" Text="{TemplateBinding Tag}" FontFamily="Segoe MDL2 Assets"
                                               FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{TemplateBinding Content}" FontSize="12" FontWeight="Medium"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="120"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#3DFFFFFF"/></Trigger>
                                <!-- "Activa" se marca cambiando el Tag de fondo desde código vía la propiedad attached no;
                                     usamos un DataTrigger sobre IsEnabled? Mejor: el borde inferior peach se pone por código. -->
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid TextElement.FontFamily="{StaticResource Jakarta}" TextElement.Foreground="{StaticResource TextPrimary}">
        <Grid.RowDefinitions>
            <RowDefinition Height="38"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===== Barra de título de la app (arrastrable entre monitores) ===== -->
        <Grid Grid.Row="0" Background="#0A0A0C" MouseLeftButtonDown="TitleBar_MouseDown">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                <Border Width="11" Height="11" CornerRadius="3" Background="{StaticResource Accent}" Margin="0,0,10,0"/>
                <TextBlock Text="arquitectSoft" FontSize="12.5" FontWeight="Bold" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0">
                <!-- Toggle cristal ↔ modo rendimiento -->
                <Button x:Name="BtnRendimiento" Click="Rendimiento_Click" Cursor="Hand"
                        VerticalAlignment="Center" Margin="0,0,14,0"
                        Background="#22FFFFFF" Foreground="{StaticResource TextPrimary}"
                        FontSize="11" FontWeight="Medium" Content="Cristal"
                        ToolTip="Alternar cristal / modo rendimiento (apaga el efecto para ir más fluido con varias ventanas)">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" CornerRadius="7" Background="{TemplateBinding Background}" Padding="12,4">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Opacity" Value="0.85"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button Style="{StaticResource WinDot}" Content="&#xE921;" Click="MinimizarApp_Click" ToolTip="Minimizar"/>
                <Button Style="{StaticResource WinDot}" Content="&#xE922;" Click="MaximizarApp_Click" ToolTip="Maximizar / Restaurar"/>
                <Button Style="{StaticResource WinDot}" Content="&#xE8BB;" Click="CerrarApp_Click" ToolTip="Salir"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="10,0,10,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ===== Barra lateral (dock) ===== -->
            <Border Grid.Column="0" Width="96" CornerRadius="18" Background="#CC161616"
                    BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" Margin="0,0,10,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,12,0,12">
                        <Button Style="{StaticResource IconButton}" Tag="&#xE8F1;" Content="Análisis" Click="Analisis_Click"/>
                        <Button Style="{StaticResource IconButton}" Tag="&#xE8B7;" Content="Puertas" Click="Puertas_Click"/>
                        <Button Style="{StaticResource IconButton}" Tag="&#xE8C8;" Content="Compon." Click="Componentes_Click"/>
                        <Button Style="{StaticResource IconButton}" Tag="&#xE71D;" Content="Subcomp." Click="Subcomponentes_Click"/>
                        <Button Style="{StaticResource IconButton}" Tag="&#xE70F;" Content="Acabados" Click="Acabados_Click"/>
                        <Button Style="{StaticResource IconButton}" Tag="&#xE713;" Content="Mecaniz." Click="Mecanizados_Click"/>
                        <Button Style="{StaticResource IconButton}" Tag="&#xE73E;" Content="Cortes" Click="Cortes_Click"/>
                        <Button Style="{StaticResource IconButton}" Tag="&#xE721;" Content="U. Medida" Click="Unidad_Click"/>
                        <Button Style="{StaticResource IconButton}" Tag="&#xE71B;" Content="Depend." Click="Dependencias_Click"/>
                        <Button Style="{StaticResource IconButton}" Tag="&#xE74E;" Content="Respaldo" Click="Respaldo_Click"/>
                        <Button Style="{StaticResource IconButton}" Tag="&#xE8B5;" Content="Importar" Click="Importar_Click"/>
                        <Button Style="{StaticResource IconButton}" Tag="&#xE946;" Content="Acerca" Click="Acerca_Click"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ===== Escritorio (canvas) ===== -->
            <Border Grid.Column="1" x:Name="DeskCard" CornerRadius="18" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1"
                    ClipToBounds="True">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#1A1726" Offset="0"/>
                        <GradientStop Color="#1D2630" Offset="0.6"/>
                        <GradientStop Color="#2A211C" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Image x:Name="ImgFondo" Grid.RowSpan="2" Stretch="UniformToFill" Opacity="0.9"/>

                    <!-- Área de ventanas -->
                    <Grid Grid.Row="0">
                        <TextBlock Text="Escritorio" Foreground="#5C5C5C" FontSize="11" FontWeight="Medium"
                                   HorizontalAlignment="Left" VerticalAlignment="Top" Margin="16,12,0,0"/>
                        <Canvas x:Name="Lienzo" Background="Transparent" SizeChanged="Lienzo_SizeChanged"/>
                        <!-- Vista previa de la zona de snap (Aero Snap) -->
                        <Border x:Name="PreviewSnap" Visibility="Collapsed" IsHitTestVisible="False"
                                CornerRadius="10" Background="#33E07B5B" BorderBrush="#CCE07B5B" BorderThickness="2"
                                HorizontalAlignment="Left" VerticalAlignment="Top"/>
                    </Grid>

                    <!-- Barra de tareas (se oculta cuando no hay ventanas) -->
                    <Border x:Name="BarraTareasHost" Grid.Row="1" Visibility="Collapsed"
                            Margin="8,6,8,8" CornerRadius="14" Background="#B2161616"
                            BorderBrush="{StaticResource PanelBorder}" BorderThickness="1">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="BarraTareas" Orientation="Horizontal" Margin="6,5"/>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
