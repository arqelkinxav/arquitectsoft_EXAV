<UserControl x:Class="arquitectSoft.View.Wpf.SoftShadow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsHitTestVisible="False">
    <!-- Sombra pre-renderizada en 9-slice: esquinas fijas (64px), bordes/centro estirables.
         Reemplaza a DropShadowEffect (blur vivo, coste por area de pixeles). Coste ~0 al maximizar.
         CardShadow.png = 200x200, glow negro suave sobre transparente. -->
    <UserControl.Resources>
        <BitmapImage x:Key="ShImg" UriSource="pack://application:,,,/Resources/CardShadow.png"/>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="64"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="64"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="64"/>
        </Grid.RowDefinitions>

        <Image Grid.Row="0" Grid.Column="0" Stretch="Fill">
            <Image.Source><CroppedBitmap Source="{StaticResource ShImg}" SourceRect="0,0,64,64"/></Image.Source></Image>
        <Image Grid.Row="0" Grid.Column="1" Stretch="Fill">
            <Image.Source><CroppedBitmap Source="{StaticResource ShImg}" SourceRect="64,0,72,64"/></Image.Source></Image>
        <Image Grid.Row="0" Grid.Column="2" Stretch="Fill">
            <Image.Source><CroppedBitmap Source="{StaticResource ShImg}" SourceRect="136,0,64,64"/></Image.Source></Image>

        <Image Grid.Row="1" Grid.Column="0" Stretch="Fill">
            <Image.Source><CroppedBitmap Source="{StaticResource ShImg}" SourceRect="0,64,64,72"/></Image.Source></Image>
        <Image Grid.Row="1" Grid.Column="1" Stretch="Fill">
            <Image.Source><CroppedBitmap Source="{StaticResource ShImg}" SourceRect="64,64,72,72"/></Image.Source></Image>
        <Image Grid.Row="1" Grid.Column="2" Stretch="Fill">
            <Image.Source><CroppedBitmap Source="{StaticResource ShImg}" SourceRect="136,64,64,72"/></Image.Source></Image>

        <Image Grid.Row="2" Grid.Column="0" Stretch="Fill">
            <Image.Source><CroppedBitmap Source="{StaticResource ShImg}" SourceRect="0,136,64,64"/></Image.Source></Image>
        <Image Grid.Row="2" Grid.Column="1" Stretch="Fill">
            <Image.Source><CroppedBitmap Source="{StaticResource ShImg}" SourceRect="64,136,72,64"/></Image.Source></Image>
        <Image Grid.Row="2" Grid.Column="2" Stretch="Fill">
            <Image.Source><CroppedBitmap Source="{StaticResource ShImg}" SourceRect="136,136,64,64"/></Image.Source></Image>
    </Grid>
</UserControl>
